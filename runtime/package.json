{
  "name": "mnemosyne-runtime",
  "version": "1.0.0",
  "description": "Mnemosyne — Personal AI Runtime (cross-client, cross-session, cross-model continuous identity)",
  "license": "MIT",
  "author": "杳晦 (Mnemosyne Team)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run test/integration",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "relocate": "tsx scripts/relocate.ts",
    "huginn": "tsx scripts/huginn.ts"
  },
  "files": [
    "dist/",
    "LICENSE",
    "NOTICE.md"
  ],
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "cron-parser": "^4.9.0",
    "fastify": "^5.0.0",
    "ioredis": "^5.4.1",
    "opusscript": "^0.1.1",
    "pg": "^8.13.0",
    "prom-client": "^15.1.3",
    "undici": "^6.28.0",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
