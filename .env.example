# ─── Database ───
DB_PASSWORD=your_secure_db_password_here

# ─── Encryption（32 字节 base64；openssl rand -base64 32）───
ENCRYPTION_KEY=your_32_byte_base64_key_here
JWT_SECRET=your_jwt_secret_here

# ─── API Keys (LLM Provider) ───
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...
GEMINI_API_KEY=...

# ─── TTS Provider（§21；OPENAI_API_KEY 复用上方 LLM key 用于 tts-1-hd）───
ELEVENLABS_API_KEY=sk_...            # 质量天花板；Free tier 10k chars/月
ELEVENLABS_VOICE_ID=                 # ElevenLabs 声音 ID（如 Lily）；留空则不合成、静默降级为文字
GOOGLE_TTS_API_KEY=...               # 备选：Chirp 3 HD，1M chars/月免费

# ─── LiteLLM ───
LITELLM_MASTER_KEY=sk-litellm-...

# ─── Local Model Sidecar（§20）───
# 形态 A（Tailscale 分离部署，推荐）：OLLAMA_API_BASE=http://100.x.x.x:11434
# 形态 B（同机 profile）：OLLAMA_API_BASE=http://ollama:11434
OLLAMA_API_BASE=http://ollama:11434

# ─── Twig Memory ───
KIMI_API_KEY=sk-...
MUNINN_AUTH_TOKEN=your_twig_auth_token
MUNINN_TZ=Asia/Shanghai

# ─── Grafana（仅在 monitoring profile 启用时需要）───
GRAFANA_PASSWORD=your_grafana_password

# ─── MCP / OAuth（if needed）───
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
SEMANTIC_SCHOLAR_API_KEY=...
SMITHERY_API_KEY=...

# ─── Token Broker（§5.3 内部共享密钥）───
BROKER_INTERNAL_TOKEN=your_broker_shared_secret

# ─── 确认协议（§4.6 HMAC 票据密钥）───
CONFIRM_SECRET=your_hmac_secret_for_confirmation_tickets

# ─── MCP Gateway（§5 工具执行回路）───
# 本地 dev 默认 http://127.0.0.1:3000；compose 内为 http://mcp-gateway:3000；
# Zeabur 用私有地址（形如 http://mcp-gateway.zeabur.internal:3000）。
# ⚠️ 不配 = 工具全废且静默（模型收不到结果就开始瞎编）；/health 的 mcp 字段可验。
MCP_GATEWAY_URL=

# ─── Telegram 适配层（§1 传输层；留空 = 轮询关闭）───
TELEGRAM_BOT_TOKEN=

# ─── Bootstrap（首个用户仅能用一次；用后从环境中移除）───
BOOTSTRAP_TOKEN=one_time_bootstrap_token

# ─── Webhook 校验链（§2.5.1）───
# LAN 场景显式开启才允许 http（生产保持为空/0）
ALLOW_INSECURE_WEBHOOK=0
# 可选白名单，逗号分隔；配置后仅允许列内主机
WEBHOOK_HOST_ALLOWLIST=

# ─── Runtime 运行参数 ───
PRIVACY_LOCAL_THRESHOLD=70
CRISIS_SILENCE_HOURS=24
MAX_MESSAGE_TOKENS=4096

# ─── 备份（§13.6）───
BACKUP_RESTIC_PASSWORD=your_restic_password
B2_ACCOUNT_ID=...
B2_ACCOUNT_KEY=...
